# Variáveis de ambiente (real) — manter apenas o .env.example versionado
.env
.env.*
!.env.example

# Dados persistentes (o Postgres e o n8n usam volumes Docker nomeados,
# gerenciados pelo próprio Docker — não há diretórios locais a ignorar aqui)

# Logs
*.log
logs/

# Arquivos temporários do sistema
.DS_Store
Thumbs.db
Desktop.ini

# Arquivos temporários diversos
*.tmp
*.swp
*~
