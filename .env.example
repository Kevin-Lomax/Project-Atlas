# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=troque_essa_senha

# ==========================================
# n8n Database
# ==========================================

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# ==========================================
# Timezone
# ==========================================

TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# ==========================================
# URLs
# ==========================================
# O acesso externo ao n8n é feito via Nginx (portas 80/443 do host), não
# pela porta 5678 diretamente — essa porta não é publicada ao host neste
# stack. O Nginx termina TLS (Let's Encrypt/Certbot) e redireciona todo
# tráfego HTTP para HTTPS.
#
# Troque "seu-dominio.duckdns.org" pelo domínio configurado no Certbot
# (ver docs/ARCHITECTURE.md e docs/ADR/0002-https-e-hardening.md).

N8N_HOST=seu-dominio.duckdns.org
N8N_PORT=5678
N8N_PROTOCOL=https

N8N_WEBHOOK_URL=https://seu-dominio.duckdns.org/
N8N_EDITOR_BASE_URL=https://seu-dominio.duckdns.org/

# Só necessário como stopgap temporário caso o ambiente ainda não tenha
# HTTPS configurado (n8n exige cookie seguro fora de localhost mesmo com
# N8N_PROTOCOL=http). Remover assim que o HTTPS estiver ativo.
# N8N_SECURE_COOKIE=false

# ==========================================
# Nodes, arquivos e concorrência
# ==========================================
# Estas três variáveis são OBRIGATÓRIAS para o pipeline funcionar.
# Sem elas os workflows 02, 03 e 04 falham na ativação ou em execução.
#
# 1. O n8n 2.0 desabilita ExecuteCommand e LocalFileTrigger por padrão.
#    O Workflow 02 usa ExecuteCommand para chamar o ffmpeg e os
#    workflows 02/03/04 o usam para limpar arquivos temporários.
#    Declarar a lista vazia reabilita os nodes.
#    Trade-off: workflows desta instância passam a poder executar
#    comandos de shell dentro do container.
NODES_EXCLUDE=[]

# 2. O n8n restringe acesso ao filesystem (padrão: ~/.n8n-files).
#    O separador é PONTO E VÍRGULA, não dois-pontos.
#    Libera apenas os dois diretórios usados pelo pipeline.
N8N_RESTRICT_FILE_ACCESS_TO=/tmp;/media

# 3. Cada vídeo passa por download + gravação em disco + ffmpeg.
#    Em VM pequena, execuções simultâneas esgotam a memória.
N8N_CONCURRENCY_PRODUCTION_LIMIT=1

# ==========================================
# Autenticação
# ==========================================
# A autenticação é feita pelo sistema de usuários próprio do n8n (tela
# de setup no primeiro acesso). As variáveis N8N_BASIC_AUTH_* foram
# removidas deste stack por estarem depreciadas e sem efeito nas
# versões atuais do n8n.
