# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=troque_essa_senha

# ==========================================
# n8n Database
# ==========================================

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

# ==========================================
# n8n Login
# ==========================================

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_essa_senha

# ==========================================
# Timezone
# ==========================================

TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# ==========================================
# URLs
# ==========================================
# O acesso externo ao n8n é feito via Nginx (porta 80 do host), não pela
# porta 5678 diretamente — essa porta não é publicada ao host neste stack.
# Troque "localhost" pelo domínio ou IP público do seu host.
#
# Este stack não implementa TLS/HTTPS em nenhuma camada. Se precisar de
# HTTPS, isso exige uma decisão arquitetural própria (ex.: terminação TLS
# no Nginx ou em uma camada externa) antes de trocar os valores abaixo
# para https.

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

WEBHOOK_URL=http://localhost/
N8N_EDITOR_BASE_URL=http://localhost/
