      {
        "id": "consolidar-status",
        "name": "Consolidar Status Final",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [3240, 60],
        "notes": "Status derivado das publicacoes reais, nao de suposicao do fluxo.",
        "parameters": {
          "operation": "executeQuery",
          "query": "-- PUBLISHED so quando TODAS as redes habilitadas tem publicacao\n-- confirmada. Contar e comparar (em vez de usar NOT EXISTS) e o que\n-- garante que uma rede sem nenhuma tentativa registrada nao seja\n-- silenciosamente tratada como sucesso.\nUPDATE videos v\nSET status = CASE\n    WHEN (SELECT count(*) FROM social_networks WHERE enabled) > 0\n     AND (SELECT count(*) FROM social_networks WHERE enabled) =\n         (SELECT count(*) FROM video_publications p\n          JOIN social_networks n ON n.id = p.network_id\n          WHERE p.video_id = v.id AND n.enabled AND p.status = 'PUBLISHED')\n      THEN 'PUBLISHED'\n    WHEN EXISTS (\n        SELECT 1 FROM video_publications p\n        WHERE p.video_id = v.id AND p.status = 'PUBLISHED'\n    ) THEN 'PARTIAL'\n    ELSE 'ERROR'\n  END\nWHERE v.id = $1\nRETURNING id, status, drive_file_id, filename;",
          "options": {
            "queryReplacement": "={{ [ $('Preparar Arquivo Publico').item.json.videoId ] }}"
          }
        },
        "credentials": {
          "postgres": { "id": "b7e1f2a0-0001-4a11-9a11-000000000001", "name": "Postgres - Project Atlas" }
        }
      },
