          "query": "INSERT INTO video_publications (video_id, network_id, status, external_post_id, published_at)\nSELECT $1, n.id, 'PUBLISHED', $2, now() FROM social_networks n WHERE n.code = 'FACEBOOK'\nON CONFLICT (video_id, network_id) DO UPDATE SET\n  status = 'PUBLISHED', external_post_id = EXCLUDED.external_post_id,\n  published_at = now(), error_message = NULL;",
          "options": {
