      {
        "id": "preparar-publico",
        "name": "Preparar Arquivo Publico",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [840, 60],
        "notes": "Nome aleatorio: o arquivo fica publico durante a publicacao, entao o nome nao pode ser adivinhavel.",
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const src = $('Postgres - Buscar Videos Prontos').item.json;\nconst cfg = $('Config - Publicacao').first().json;\n\nconst ext = (src.filename || '').includes('.')\n  ? src.filename.split('.').pop().toLowerCase()\n  : 'mp4';\n\n// Nome aleatorio e nao sequencial. Enquanto o arquivo esta em /media ele e\n// publicamente acessivel, entao o nome precisa ser impossivel de adivinhar.\nconst token = [...Array(4)]\n  .map(() => Math.random().toString(36).slice(2, 10))\n  .join('');\nconst publicName = `${token}.${ext}`;\n\n// Legenda: usa a transcricao gerada no Workflow 02. O limite de caption do\n// Instagram e 2200 caracteres.\nconst caption = String(src.transcript || '').trim().slice(0, 2200);\n\nreturn {\n  json: {\n    videoId: src.id,\n    driveFileId: src.drive_file_id,\n    filename: src.filename,\n    igEnabled: src.ig_enabled === true,\n    fbEnabled: src.fb_enabled === true,\n    publicName,\n    publicPath: `/media/${publicName}`,\n    publicUrl: `${cfg.mediaBaseUrl}/${publicName}`,\n    caption,\n  },\n};"
        }
      },
