      {
        "id": "buscar-prontos",
        "name": "Postgres - Buscar Videos Prontos",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [240, 60],
        "notes": "Lote pequeno por execucao: evita estourar rate limit da Meta e memoria da VM.",
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT v.id,\n       v.drive_file_id,\n       v.filename,\n       COALESCE(t.transcript_text, '') AS transcript,\n       (SELECT enabled FROM social_networks WHERE code = 'INSTAGRAM') AS ig_enabled,\n       (SELECT enabled FROM social_networks WHERE code = 'FACEBOOK') AS fb_enabled\nFROM videos v\nLEFT JOIN video_transcriptions t ON t.video_id = v.id\nWHERE v.status = 'TRANSCRIBED'\nORDER BY v.created_at\nLIMIT 3;",
          "options": {}
        },
        "credentials": {
          "postgres": { "id": "b7e1f2a0-0001-4a11-9a11-000000000001", "name": "Postgres - Project Atlas" }
        }
