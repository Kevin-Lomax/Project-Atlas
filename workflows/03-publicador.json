      {
        "id": "ig-registrar",
        "name": "IG - Registrar Publicacao",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [2440, -160],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO video_publications (video_id, network_id, status, external_post_id, published_at)\nSELECT $1, n.id, 'PUBLISHED', $2, now() FROM social_networks n WHERE n.code = 'INSTAGRAM'\nON CONFLICT (video_id, network_id) DO UPDATE SET\n  status = 'PUBLISHED', external_post_id = EXCLUDED.external_post_id,\n  published_at = now(), error_message = NULL;",
