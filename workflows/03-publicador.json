      {
        "id": "ig-limite",
        "name": "IG - Limite de Tentativas",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [2040, 160],
        "notes": "A Meta recomenda no maximo ~5 min de polling. Passando disso, falha explicitamente.",
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "// $runIndex conta quantas vezes este node ja rodou nesta execucao, o que\n// funciona como contador natural do laco de polling.\nconst tentativa = $runIndex + 1;\nconst maxTentativas = 10;\n\nconst statusAtual = $input.item.json.status_code || 'DESCONHECIDO';\n\nif (statusAtual === 'ERROR' || statusAtual === 'EXPIRED') {\n  throw new Error(`Instagram devolveu status ${statusAtual} para o container`);\n}\n\nif (tentativa >= maxTentativas) {\n  throw new Error(\n    `Container do Instagram nao ficou pronto apos ${maxTentativas} verificacoes (ultimo status: ${statusAtual})`\n  );\n}\n\nreturn $input.item;"
        }
      },
